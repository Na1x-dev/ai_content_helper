# Copy to .env.production and replace every placeholder before deployment.
# Never commit .env.production or real credentials.

# Public domain pointing to this server (without scheme or path)
DOMAIN=example.com

# Django
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=example.com
CSRF_TRUSTED_ORIGINS=https://example.com
CORS_ALLOWED_ORIGINS=https://example.com
SECURE_SSL_REDIRECT=False
AI_MOCK_MODE=False
OPENAI_API_KEY=replace-with-your-openai-api-key
# Optional provider-compatible API endpoint:
# OPENAI_BASE_URL=https://api.openai.com/v1

# PostgreSQL (use a unique strong password)
POSTGRES_DB=ai_content_db
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Google OAuth
VITE_GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Initial admin account — set a strong unique password
ADMIN_USER=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Frontend API calls should use the same-origin path behind Caddy
VITE_API_URL=/api/
WEB_CONCURRENCY=3
