# ==============================================================================
# БЭКЕНД: Системные настройки Django
# ==============================================================================
DEBUG=True
AI_MOCK_MODE=True
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=https://proxyapi.ru
SECRET_KEY=DJANGO_SECRET_KEY

ALLOWED_HOSTS=localhost,127.0.0.1,://my-saas.com, ваша-доменная-зона.com,frontend,web
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://my-saas.com, https://ваша-доменная-зона.com
GOOGLE_AUTH_CALLBACK_URL=https://my-saas.com, https://ваша-доменная-зона.com

# Настройки для Docker-окружения
POSTGRES_DB=DB
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
DATABASE_URL=postgres://USER:PASSWORD@db:5432/DB

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Данные для быстрого входа в админку Django
ADMIN_USER=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=my_super_secure_password_123

# ==============================================================================
# ФРОНТЕНД & ИНТЕГРАЦИИ (Префикс VITE_ обязателен для чтения в React)
# ==============================================================================
# Главный переключатель адреса API для фронтенда!
VITE_API_URL=http://localhost:8000/api/, https://xn-----6kcabbitjw5cnadhh2npf.com

# Обратите внимание: для Vite нужен префикс VITE_
VITE_GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET

# Разрешенные адреса для CORS в Django (через запятую)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173